# Pay with Zold — checkout service. Copy to .env (gitignored) and edit.

# Where this service listens.
CHECKOUT_PORT=3100

# The core Zold API (services/api of the main repo).
CORE_API_URL=http://127.0.0.1:3000

# The public origin this service is served from. It MUST also appear in the
# core API's WEBAUTHN_ORIGINS, or every passkey ceremony started here is
# rejected server-side.
CHECKOUT_PUBLIC_ORIGIN=http://localhost:3100

# Send X-Forwarded-For upstream so the core's per-IP rate limits key on the
# real client. Leave on for any hosted deploy. Consequence: the core refuses
# its /api/simulate/* routes for forwarded requests, which is why the dev
# shortcuts below exist as a separate, loopback-only path.
FORWARD_CLIENT_IP=1

# LOCAL DEMOS ONLY. Enables self-approved KYC and simulated deposits so a
# new-user run can complete without a funding rail. Refused at startup unless
# CORE_API_URL is loopback. Never set this on a hosted deploy.
ALLOW_DEV_SHORTCUTS=0

# --- What the CORE API needs, for reference (set these in the main repo) -----
# RP_ID=zold.app
# WEBAUTHN_ORIGINS=https://app.zold.app,https://checkout.zold.app
# TRUSTED_PROXY_HOPS=1

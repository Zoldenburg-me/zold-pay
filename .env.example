# Pay with Zold — checkout service. Copy to .env (gitignored) and edit.
# Never commit a real .env. Production refuses to start on an unsafe config.

# Where this service listens.
CHECKOUT_PORT=3100

# The core Zold API (services/api of the main repo).
CORE_API_URL=http://127.0.0.1:3000

# The public origin this service is served from. It MUST also appear in the
# core API's WEBAUTHN_ORIGINS, or every passkey ceremony started here is
# rejected server-side. Must be https (and not localhost) in production.
CHECKOUT_PUBLIC_ORIGIN=http://localhost:3100

# Where a new user creates a Zold account. This checkout only serves existing
# users; the page links here for everyone else. Defaults to <origin>/app.
# ZOLD_APP_URL=https://app.zold.app

# Send X-Forwarded-For upstream so the core's per-IP rate limits key on the
# real client. Leave on for any hosted deploy.
FORWARD_CLIENT_IP=1

# LOCAL DEMOS ONLY. Seeds a demo merchant whose redirect URIs are a wildcard.
# Refused at startup unless CORE_API_URL is loopback, and refused in production.
# (The core no longer has simulated KYC or deposits, so this does nothing else.)
ALLOW_DEV_SHORTCUTS=0

# HMAC key for the per-merchant pseudonymous payer id. REQUIRED — the service
# refuses to start without it (and without 32+ characters in production). It
# cannot be generated per start: it is what lets a merchant recognise a
# returning customer, so a fresh value turns every repeat payer into a stranger.
# Generate once and keep it:
#   node -e 'console.log(require("crypto").randomBytes(32).toString("base64url"))'
CHECKOUT_SUBJECT_SECRET=

# --- Environment ----------------------------------------------------------------
# Set NODE_ENV explicitly. NODE_ENV=production turns on the fail-closed checks
# below; NODE_ENV=development says this really is a local run. If it is unset and
# CHECKOUT_PUBLIC_ORIGIN is not localhost, the service refuses to start, so a
# hosted deployment cannot skip the production checks by forgetting this.
# NODE_ENV=production
#
# Numeric settings below must be positive numbers; a malformed value stops the
# service instead of quietly disabling the limit.

# --- Production (NODE_ENV=production) -----------------------------------------
# Reverse-proxy hops in front of this service, so the client address used for
# rate limiting is not spoofable. REQUIRED in production; 0 means nothing in front.
# TRUSTED_PROXY_HOPS=1

# --- Limits (defaults shown) --------------------------------------------------
# Largest checkout amount accepted, in EUR.
# CHECKOUT_MAX_AMOUNT_EUR=10000
# Most open (pending) checkouts one merchant may have at once. Intent creation is
# reachable with only the public client_id, so this bounds abuse. Abandoned
# checkouts are removed after an hour.
# CHECKOUT_MAX_PENDING_INTENTS=1000
# The same cap for checkouts started through the unauthenticated GET /authorize,
# counted separately so that a flood of those cannot stop a merchant's own
# authenticated checkouts. Only checkouts still inside their 15-minute window count.
# CHECKOUT_MAX_PENDING_FRONT_INTENTS=200
# Requests per minute per client address: all of /api and /bff, and per
# credential-guessing route (token, intents, status, attach).
# RATE_LIMIT_GENERAL=300
# RATE_LIMIT_CREDENTIAL=20
# Checkouts started per minute through the unauthenticated GET /authorize, per
# merchant across every address. The authenticated back channel is not counted.
# RATE_LIMIT_CLIENT=60
#
# A line in this file that the loader would skip or misread (no KEY=value, a key
# set twice, an unclosed quote, a # inside an unquoted value, text after a
# closing quote), or a .env that cannot be read, stops the service at start.
# The error names the file and line numbers, never a value. Quote values that
# contain #.

# --- Settlement (AUTHORIZED -> PAID / FAILED) --------------------------------
# Zold's checkout-service credential (zsc_...), issued by a Zold operator with
# POST /api/admin/service-credentials/checkout/rotate. Unset: AUTHORIZED
# checkouts never settle; production refuses to start unless SETTLE_DISABLED=1.
# Refused over plain http to a CORE_API_URL that is not loopback.
# ZOLD_SERVICE_TOKEN=
# SETTLE_DISABLED=1
# Optional: the whsec_ secret Zold's CHECKOUT_WEBHOOK_SECRET holds (at least 24
# bytes). Mounts POST /bff/zold/webhook. Needs ZOLD_SERVICE_TOKEN.
# ZOLD_WEBHOOK_SECRET=
# On the Zold side that pairs with: CHECKOUT_WEBHOOK_URL=https://<this origin>/bff/zold/webhook
# and CHECKOUT_WEBHOOK_SECRET set to the same whsec_ value.
# How often AUTHORIZED checkouts are checked, in whole seconds from 10 to 3600.
# SETTLE_POLL_SECONDS=60

# --- Shopify adapter (custom-app mode, see docs/shopify.md) --------------------
# The app's client id and secret from the Shopify Partner Dashboard. Both or
# neither: neither turns Shopify off and no /shopify route exists. With them,
# the service refuses to start unless SHOPIFY_TOKEN_KEY, CORE_PUBLIC_URL and
# ZOLD_SERVICE_TOKEN are set too.
# SHOPIFY_API_KEY=
# SHOPIFY_API_SECRET=
# AES-256-GCM key that seals each store's access token and pay-link secret in
# data/checkout.json: base64 of exactly 32 random bytes. Changing it makes every
# stored token unreadable (stores then reconnect). Generate once and keep it:
#   node -e 'console.log(require("crypto").randomBytes(32).toString("base64"))'
# SHOPIFY_TOKEN_KEY=
# Zold's public origin; the merchant returns to its /business after connecting a
# store. CORE_API_URL may be an internal address, so this is separate. https in
# production.
# CORE_PUBLIC_URL=https://zold.example
# Defaults shown.
# SHOPIFY_SCOPES=read_orders,write_orders
# A Zold order is one whose payment method name contains this (case-insensitive).
# SHOPIFY_MANUAL_GATEWAY=zold
# SHOPIFY_API_VERSION=2026-07
# TESTS ONLY: send every store's calls to <base>/<shop>/... on a loopback stub.
# Refused in production.
# SHOPIFY_SHOP_BASE_URL=
# On the Shopify app: redirect URL https://<this origin>/shopify/callback. The
# webhooks (orders/create, orders/cancelled, app/uninstalled) are subscribed at
# https://<this origin>/shopify/webhooks when a store connects.

# --- What the CORE API needs, for reference (set these in the main repo) -----
# RP_ID=zold.app
# WEBAUTHN_ORIGINS=https://app.zold.app
# TRUSTED_PROXY_HOPS=1
# For the Shopify adapter: CHECKOUT_SERVICE_ORIGIN=<this origin>, a checkout
# service credential issued, and data encryption configured (merchant links).

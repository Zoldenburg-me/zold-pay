{
  "name": "pay-with-zold",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Pay with Zold — hosted merchant checkout for existing Zold users",
  "engines": { "node": ">=22.8" },
  "scripts": {
    "dev": "tsx watch server/src/server.ts",
    "start": "tsx server/src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "coverage": "node --import tsx --test --experimental-test-coverage --test-coverage-include=\"server/src/**\" --test-coverage-lines=80 --test-coverage-branches=80 --test-coverage-functions=80 test/*.test.ts",
    "check": "npm run typecheck && npm run coverage",
    "gate": "npm run check && npm audit --audit-level=low",
    "harness:smoke": "tsx scripts/harness-smoke.ts"
  },
  "dependencies": {
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "viem": "^2.21.54"
  }
}
